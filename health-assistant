class BMIScreen(Screen):
    def on_pre_enter(self):
        self.ids.weight.text = ""
        self.ids.height.text = ""
        self.ids.bmi_result.text = ""

    def calculate_bmi(self):
        weight_text = self.ids.weight.text.strip()
        height_text = self.ids.height.text.strip()

        try:
            weight = float(weight_text)
            height_cm = float(height_text)
            height_m = height_cm / 100
            bmi = weight / (height_m ** 2)
            bmi_str = f"{bmi:.2f}"
            if bmi < 18.5:
                status = "Underweight"
            elif bmi < 25:
                status = "Normal weight"
            elif bmi < 30:
                status = "Overweight"
            else:
                status = "Obese"

            result = f"Your BMI is {bmi_str}. Status: {status}."
            self.ids.bmi_result.text = result
            speak(result)
        except ValueError:
            msg = "Please enter valid numeric weight and height."
            self.ids.bmi_result.text = msg
            speak(msg)

    def back_to_menu(self):
        self.manager.current = 'menu'

