def get_closest_match(user_input, database):
    user_input = user_input.strip().lower()
    for key, synonyms in SYMPTOM_SYNONYMS.items():
        if user_input in synonyms:
            return key
    matches = difflib.get_close_matches(user_input, list(database.keys()), n=1, cutoff=0.6)
    return matches[0] if matches else None

class AgeVerificationScreen(Screen):
    def verify_age(self):
        age_text = self.ids.age_input.text.strip()
        try:
            age = int(age_text)
            if age >= 16:
                self.ids.age_warning.text = ""
                App.get_running_app().user_age = age
                speak("Access granted. Welcome.")
                self.manager.current = "menu"
            else:
                self.ids.age_warning.text = "Access denied. Must be 16+."
                speak("Access denied. You must be sixteen years or older.")
        except ValueError:
            self.ids.age_warning.text = "Please enter a valid age."
            speak("Please enter a valid age.")

class MenuScreen(Screen):
    pass

class SymptomScreen(Screen):
    def on_pre_enter(self):
        self.ids.symptom_input.text = ""
        self.ids.age_input.text = ""
        self.ids.symptom_result.text = ""

    def check_symptom(self):
        symptom = self.ids.symptom_input.text.strip().lower()
        age_text = self.ids.age_input.text.strip()

        if not symptom:
            msg = "Please enter a symptom."
            self.ids.symptom_result.text = msg
            speak(msg)
            return

        try:
            age = int(age_text)
        except ValueError:
            msg = "Please enter a valid age."
            self.ids.symptom_result.text = msg
            speak(msg)
            return

        match = get_closest_match(symptom, SYMPTOM_DB)
        if match:
            data = SYMPTOM_DB[match]
            result = f"[b]Symptom:[/b] {match.capitalize()}\n\n[b]Advice:[/b] {data['advice']}"
            if data['medicines']:
                result += "\n\n[b]Recommended Medicines and Dosages:[/b]"
                for med in data['medicines']:
                    med_info = MEDICINE_DB.get(med)
                    if med_info:
                        dose = med_info['child_dose'] if age <= 12 else med_info['adult_dose']
                        result += f"\n- [b]{med.capitalize()}[/b]: {dose}"
        else:
            result = "Symptom not found. Please consult a healthcare professional."

        self.ids.symptom_result.text = result
        speak(result)

    def voice_input(self):
        self.ids.symptom_result.text = "Listening..."
        def run_listen():
            text = listen()
            def update_ui(dt):
                if text:
                    self.ids.symptom_input.text = text
                    self.check_symptom()
                else:
                    msg = "Could not understand voice input. Please try again."
                    self.ids.symptom_result.text = msg
                    speak(msg)
            Clock.schedule_once(update_ui)
        threading.Thread(target=run_listen, daemon=True).start()

    def back_to_menu(self):
        self.manager.current = 'menu'

